specification {
  element user {
    style {
      shape person
      color green
    }
  }

  element askZamunda {
    style {
      shape browser
    }
  }

  element frontend {
    style {
      color amber
    }
  }

  element llmService {
    style {
      shape rectangle
      color sky
    }
  }

  element database {
    style {
      shape cylinder
      color slate
    }
  }

  element externalSystem {
    style {
      shape rectangle
      color gray
    }
  }

  element backend {
    style {
      shape rectangle
      color blue
    }
  }

  element identityProvider {
    style {
      shape rectangle
      color blue
    }
  }

  element messageQueue {
    style {
      shape queue
      color green
    }
  }
}

model {
  // --- Külső szereplők és rendszerek ---

  taxAuthority = externalSystem "National Tax Authority / Legal Repository" "Official legislation data and change notices"

  identityAgent = identityProvider "Central Identity Agent" "User Data"

  guestUser = user "Guest User"

  userRegistered = user "Registered User" {
    individualUser = user "Individual Citizen" "Private tax and legal matters"
    companyUser    = user "Corporate Entity"  "Corporate tax and regulatory matters"
  }

  admin = user "Government Admin" "Manages system and knowledge base" {
    systemAdmin = user "System Administrator" "Maintains UI and technical systems"
    dataAdmin   = user "Data Administrator"   "Processes and uploads legislation documents"
  }

  // --- Az Ask Zamunda rendszer (C4 Level 2 – Container diagram) ---

  askZamunda = askZamunda "Ask Zamunda" {

    // Frontendek
    guestUserFrontend      = frontend "Guest User Frontend"      "Chat UI for unauthenticated users"
    registeredUserFrontend = frontend "Registered User Frontend" "Chat UI with saved sessions"
    adminFrontend          = frontend "Admin Frontend"           "Document management and system administration"

    // Háttérszolgáltatások (SBA)
    chatService = backend "Chat Service" "Handles chat requests, streaming responses, session management"
    docService  = backend "Document Ingestion Service" "Validates, processes and publishes new legislation documents"

    // EDA – eseményvezérelt dokumentumfeldolgozás
    eventBus = messageQueue "Event Bus" "Async document processing pipeline"

    // Dokumentumvektorizáló (fogyasztó az Event Bus-ról)
    vectorizer = backend "Document Vectorizer" "Chunks, embeds and indexes documents into the Vector DB"

    // LLM és tudásbázis
    llm      = llmService "LLM"             "Generates streaming answers based on retrieved context"
    vectorDb = database   "Vector Database" "Knowledge base – indexed legislation (RAG)"
  }

  // --- System Context összefüggések (C4 Level 1) ---

  // Felhasználók a rendszer felületeivel
  guestUser      -> guestUserFrontend "Chats anonymously"
  userRegistered -> registeredUserFrontend "Chats and manages chat history"
  admin          -> adminFrontend "Uploads documents and manages system"

  // Human-in-the-loop: a külső hatóság az Adminnak küldi a dokumentumokat,
  // az Admin validál és tölt fel – a hatóságnak nem kell megtanulni a rendszert
  taxAuthority -> admin "Sends legislation documents / change notices via API or web surface"

  // Azonosítás
  userRegistered -> identityAgent "Authenticates & manages personal data"
  identityAgent  -> askZamunda   "Provide secure token / auth session"

  // --- Container összefüggések (C4 Level 2) ---

  // Frontendek → Chat Service
  guestUserFrontend      -> chatService "Forwards chat request (REST/SSE)"
  registeredUserFrontend -> chatService "Forwards chat request (REST/SSE)"

  // Chat Service → LLM + Vector DB (RAG folyamat)
  chatService -> vectorDb "Retrieves relevant legislation chunks (semantic search)"
  chatService -> llm      "Sends prompt + retrieved context"
  llm         -> chatService "Streams generated answer back"

  // Admin felület → Document Ingestion Service (az Admin validál és tölt fel)
  adminFrontend -> docService "Uploads validated document (REST)"

  // Document Ingestion Service → Event Bus (EDA belépési pont)
  docService -> eventBus "Publishes DocumentUploaded event"

  // Event Bus → Vectorizer (aszinkron fogyasztó)
  eventBus -> vectorizer "Delivers DocumentUploaded event"

  // Vectorizer → Vector DB (index frissítés)
  vectorizer -> vectorDb "Indexes new document chunks"

  // Azonosítás a backend felé
  identityAgent -> chatService "Provide secure token / auth session"
  chatService   -> identityAgent "Validates user session"
}

views {

  view systemContext {
    title "System Context – Ask Zamunda"
    include
      guestUser,
      userRegistered,
      admin,
      taxAuthority,
      askZamunda,
      identityAgent
  }

  view askZamunda of askZamunda {
    title "Container Diagram – Ask Zamunda"
    include
      askZamunda.*,
      identityAgent,
      admin,
      guestUser,
      userRegistered
  }

  view of userRegistered {
    title "Registered User Types"
    include userRegistered.*
    include identityAgent
  }

  view of admin {
    title "Admin Types"
    include admin.*
  }
}