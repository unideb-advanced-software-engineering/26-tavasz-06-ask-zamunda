specification { 
  element user { style { 
    shape person 
    color green  
  }} 

  element askZamunda { style { 
    shape browser  
  }} 

  element frontend { 
    style { 
      color amber 
    } 
  } 

  element LLM { 
    style { 
      color sky
    } 
  } 

  element database {
    style {
        shape cylinder
        color slate
    }
  }

  element externalSystem {
    style {
      shape rectangle
      color gray
    }
  }
  
  element backend {
    style {
      shape rectangle
      color blue
    }
  }

  // Új elem specifikáció az azonosításhoz
  element identityProvider {
    style {
      shape rectangle
      color blue
    }
  }
} 

model {
  // Külső rendszerek
  taxAuthority = externalSystem "National Tax Authority / Legal Repository" "Official data and changes"
  
  // Új központi azonosítási ügynök (Identity Agent)
  identityAgent = identityProvider "Central Identity Agent" "Handles OIDC / User Data Encapsulation"

  guestUser = user "Guest user" 
  admin = user "Government Admin" "Manages system and knowledge base" {
    systemAdmin = user "System Administrator" "Maintains UI and technical systems"
    dataAdmin = user "Data Administrator" "Processes and inputs data"
  }
  userRegistered = user "Registered user" {
    individualUser = user "Individual Citizen" "Private tax matters"
    companyUser = user "Corporate Entity" "Corporate tax matters"
  }

  askZamunda = askZamunda "Ask Zamunda" { 
    backend = backend "API & Orchestrator" "REST API"
    
    registeredUserFrontend = frontend "Registered User Frontend" "Option to contact authority via email"
    guestUserFrontend = frontend "Guest User Frontend" "Option to contact authority via email"
    adminFrontend = frontend "Admin Frontend" "Administration interface"
    
    llm = LLM "LLM"
    EmbeddedVectorSpace = database "Vector Database" "Knowledge base (Legislation)"
  } 

  // --- ÚJ FOLYAMATOK ---
  
  // A regisztrált felhasználó az ügynökön keresztül azonosít
  userRegistered -> identityAgent "Authenticates & Manages Personal Data"
  
  // Az ügynök csak egy tokent vagy biztonságos azonosítót ad a frontendnek
  identityAgent -> registeredUserFrontend "Secure Token / Auth Session"

  // A backend is ellenőrizheti az ügynökkel a jogosultságot, ha kell
  backend -> identityAgent "Validates user session"

  // --- EREDETI FOLYAMATOK ---

  taxAuthority -> admin "Sends data update request / Change notice"
  admin -> adminFrontend "Validates and records data"
  backend -> EmbeddedVectorSpace "Knowledge base update"

  userRegistered -> registeredUserFrontend "Request"
  guestUser -> guestUserFrontend "Request"

  registeredUserFrontend -> backend "Forwards request"
  guestUserFrontend -> backend "Forwards request"
  adminFrontend -> backend "Update command"
  
  backend -> EmbeddedVectorSpace "Context search"
  backend -> llm "Response generation"
  llm -> EmbeddedVectorSpace "RAG"
}

views {  

  view systemContext {  
    title "System Context with Identity Agent"  
    include * 
  }  

  view askZamunda {  
    title "Container Diagram"  
    include askZamunda.* 
    include identityAgent
  }    

  view of userRegistered {
    title "User Types & Identity Access"
    include userRegistered.*
    include identityAgent
  }

  view of admin {
    title "Admin Types"
    include admin.*
  }
}